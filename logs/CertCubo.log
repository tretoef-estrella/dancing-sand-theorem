OddParts.B1 : ∀ (n p : ℕ),
  Nat.Prime p →
    p ≠ 2 →
      Nonempty
        (↥(OddParts.Sylp p ↥(CubeLaplacian.K n)) ≃+
          ↥(OddParts.Sylp p ((j : Fin n) → Fin (n.choose (↑j + 1)) → ZMod (↑j + 1))))
