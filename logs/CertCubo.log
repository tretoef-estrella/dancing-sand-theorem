  4 ≤ n →
    n % 2 = 0 →
      ↑(PodiumCor.cExp (↥(CubeLaplacian.Syl2 ↥(CubeLaplacian.K n))) 1) =
          max (PodiumCor.gmax (n - 1)) (Rulers.phi n - 1) ∧
        ∀ (r : ℕ),
          2 ≤ r → r ≤ n + 1 → ↑(PodiumCor.cExp (↥(CubeLaplacian.Syl2 ↥(CubeLaplacian.K n))) r) = PodiumCor.gmax (n - 1)
